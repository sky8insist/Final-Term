# ============================================================
# Exam AI 统一配置模板（UTF-8，无 BOM）
# 复制为项目根目录 .env 后再填写；真实 .env 不得提交到版本库。
# 标记说明：[必填] 正式链路必须提供；[可选] 按功能启用；[本地] 可由脚本同步。
# ============================================================

# 应用与前端
# 演示模式保持两个 MOCK 开关为 true；正式链路应改为 false。
MOCK_EXTERNAL_APIS=true
MOCK_EMBEDDING_DIMENSIONS=1024
VITE_MOCK_APP=true
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Supabase / PostgreSQL [必填：正式链路]
# 本地自托管启动后执行 scripts/sync-local-supabase-env.ps1 自动填写密钥。
SUPABASE_URL=http://localhost:18000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
MATERIAL_STORAGE_BUCKET=study-materials
# 以下 VITE_SUPABASE_* 用于前端登录、邮箱验证与密码恢复；不得填写 service role key。
VITE_SUPABASE_URL=http://localhost:18000
VITE_SUPABASE_ANON_KEY=

# LLM / Embedding / Vision / Speech [必填：MOCK_EXTERNAL_APIS=false]
# 支持 OpenAI-compatible 服务；API Key 只能放在 EXAMAI_OPENAI_API_KEY。
EXAMAI_MODEL_PROVIDER=openai_compatible
EXAMAI_OPENAI_API_KEY=
EXAMAI_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EXAMAI_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EXAMAI_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EXAMAI_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
EXAMAI_TRANSCRIPTION_MODEL=FunAudioLLM/SenseVoiceSmall

# 公共知识检索 [可选]
# 未配置专业搜索 API 时，可仅使用无需密钥的 Wikipedia 兜底。
EXAMAI_WEB_SEARCH_URL=
EXAMAI_WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
ENABLE_WIKIPEDIA_FALLBACK=true
WIKIPEDIA_LANGUAGE=zh

# Redis / Celery
# 本地单进程验收可设 CELERY_TASK_ALWAYS_EAGER=true；生产必须为 false 并启动 Worker。
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
TASK_MAX_RETRIES=3

# LightRAG 与资料解析
# 相对路径从仓库根目录解析，禁止指向公开静态目录。
LIGHTRAG_WORKING_DIR=backend/data/lightrag
DEFAULT_ANSWER_LANGUAGE=zh-CN
MAX_UPLOAD_MB=200
# MinerU v4 精准解析 [建议正式环境配置 Token]
# PDF/Office 显式关闭 OCR；直接上传图片启用视觉识别；本地解析仅作兜底。
ENABLE_MINERU=true
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=pipeline
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_TIMEOUT_SECONDS=900
MINERU_TRANSPORT_RETRIES=3
MINERU_MAX_RESULT_MB=300
MINERU_MAX_UNPACKED_MB=800
MINERU_NATIVE_COVERAGE_THRESHOLD=0.95
MINERU_PAGE_COVERAGE_THRESHOLD=0.90
MINERU_ENABLE_LOCAL_FALLBACK=true
MAX_AUDIO_MINUTES=180
AUDIO_SEGMENT_SECONDS=600
AUDIO_SILENCE_THRESHOLD_DB=-35
AUDIO_MIN_SILENCE_SECONDS=0.7

# 功能开关
ENABLE_API_V1=true
ENABLE_ASYNC_PROCESSING=true
ENABLE_MULTIMODAL=true
ENABLE_HERMES_MEMORY=true
ENABLE_EXTERNAL_KNOWLEDGE=false
ENABLE_EXAM_GENERATION=true

# 记忆限制
ASSISTANT_MEMORY_CHAR_LIMIT=1400
USER_PROFILE_CHAR_LIMIT=900
MEMORY_CONSOLIDATION_THRESHOLD=0.8

# 配额与保留周期
MAX_ACTIVE_TASKS_PER_USER=3
MAX_DAILY_UPLOAD_MB=1000
ORIGINAL_FILE_RETENTION_DAYS=90

# 模型成本控制（美元）
MODEL_CALL_BUDGET_USD=5.0
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
EMBEDDING_COST_PER_MILLION=0
VISION_COST_PER_CALL=0
TRANSCRIPTION_COST_PER_MINUTE=0

# 可观测性与验收
REQUEST_ID_HEADER=X-Request-ID
PROMPT_VERSION=1.0.0
ACCEPTANCE_API_BASE_URL=http://localhost:8000
ACCEPTANCE_AUDIO_FILE=
