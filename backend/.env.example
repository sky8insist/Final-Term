APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=http://localhost:18000
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWT_SECRET=replace-with-local-jwt-secret
DATABASE_URL=postgresql://postgres:replace-with-password@localhost:5432/postgres

EXAMAI_OPENAI_API_KEY=replace-with-siliconflow-api-key
EXAMAI_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EXAMAI_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EXAMAI_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B

LIGHTRAG_WORKING_DIR=backend/data/lightrag
DEFAULT_ANSWER_LANGUAGE=zh-CN
MAX_UPLOAD_MB=200
