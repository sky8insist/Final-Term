# Vite is configured with envDir=".." and reads ../.env at runtime.
# Keep the canonical configuration in the repository-root .env file.
# These entries document the frontend-only variables; do not place secrets here.

# FastAPI origin. The frontend appends the canonical /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000

# Required by the first-party login, email verification, and password recovery UI.
# The anon key is public by design; never place a service role key in VITE_*.
VITE_SUPABASE_URL=http://localhost:18000
VITE_SUPABASE_ANON_KEY=
